# Copia este archivo como .env  (cp .env.example .env)  y ajusta lo que necesites.
# .env está en .gitignore: nunca lo subas a GitHub.

# --- Airflow ---
AIRFLOW_UID=50000

# --- Leaguepedia ---
# Pon tu correo o tu GitHub: Fandom pide identificar quién hace las peticiones.
LOLPRO_USER_AGENT="lol-pro-analytics/0.1 (portafolio; contacto: tu-email@ejemplo.com)"
LEAGUEPEDIA_MIN_INTERVAL_S=2.0
# Lista JSON con los nombres exactos de Tournaments.League (verifícalos con: lolpro list-leagues --year 2026)
# LOLPRO_LEAGUES='["LoL Champions Korea","Tencent LoL Pro League","LoL EMEA Championship"]'

# --- Almacenamiento raw ---
# Fuera de Docker (corriendo con uv en tu máquina) se guarda en disco local:
RAW_BASE_URI=file://data/raw
# Dentro de Docker, docker-compose.yaml lo cambia a s3://lol-raw (SeaweedFS).
# Credenciales de SeaweedFS local (deben coincidir con infra/seaweedfs/s3.json):
AWS_ACCESS_KEY_ID=lolpro-local
AWS_SECRET_ACCESS_KEY=lolpro-local-secret
# Para escribir en SeaweedFS desde tu máquina (fuera de Docker), descomenta:
# RAW_BASE_URI=s3://lol-raw
# S3_ENDPOINT_URL=http://localhost:8333
